{
  "request_id": "demo-batch-001",
  "jobs": [
    {
      "job_id": "job-1",
      "url": "https://httpbin.org/bytes/1024",
      "output_filename": "downloads/sample-1.bin",
      "timeout_seconds": 30
    },
    {
      "job_id": "job-2",
      "url": "https://httpbin.org/bytes/2048",
      "output_filename": "downloads/sample-2.bin",
      "timeout_seconds": 30
    },
    {
      "job_id": "job-3",
      "url": "https://httpbin.org/bytes/4096",
      "output_filename": "downloads/sample-3.bin",
      "timeout_seconds": 30,
      "checksum": {
        "algorithm": "sha256",
        "value": "replace_with_real_sha256_hex"
      }
    }
  ],
  "retry_policy": {
    "max_retries": 3,
    "strategy": "exponential",
    "base_delay_seconds": 1,
    "max_delay_seconds": 30,
    "jitter": true,
    "retry_on": ["timeout"]
  },
  "partial_download_policy": "cleanup",
  "duplicate_output_policy": "reject_request"
}
